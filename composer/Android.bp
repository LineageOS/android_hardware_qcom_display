composer_srcs = [
    "AidlComposerClient.cpp",
    "AidlComposer.cpp",
    "AidlComposerHandleImporter.cpp",
    "DisplayConfigAIDL.cpp",
    "gl_color_convert.cpp",
    "gl_color_convert_impl.cpp",
    "gl_common.cpp",
    "gl_layer_stitch.cpp",
    "gl_layer_stitch_impl.cpp",
    "hwc_buffer_allocator.cpp",
    "hwc_buffer_sync_handler.cpp",
    "hwc_common.cpp",
    "hwc_debugger.cpp",
    "hwc_socket_handler.cpp",
    "QServiceBackend.cpp",
    "QtiComposer3Client.cpp",
    "service.cpp",
]

cc_defaults {
    name: "composer-service_defaults",
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
        "qti_display_kernel_headers",
        "device_kernel_headers",
        "libimapper_stablec",
        "libimapper_providerutils",
        "snapalloc_interface_headers",
        "common_interface_headers",
        "sdmclient_interface_headers",
    ],

    shared_libs: [
        "libbinder",
        "libhardware",
        "libhistogram",
        "libutils",
        "libcutils",
        "libsync",
        "libc++",
        "liblog",
        "libhidlbase",
        "liblog",
        "libfmq",
        "libhardware_legacy",
        "libsdmcore",
        "libqservice",
        "libdisplaydebug",
        "libsdmutils",
        "libui",
        "libgpu_tonemapper",
        "libEGL",
        "libGLESv2",
        "libGLESv3",
        "android.hardware.graphics.allocator-V2-ndk",
        "libgralloc.qti",
        "libgralloctypes",
        "libdisplayconfig.qti",
        "libdrm",
        "libbinder_ndk",
        "android.hardware.common-V2-ndk",
        "vendor.qti.hardware.display.demura-V1-ndk",
        "libgrallocutils",
        "libtinyxml2",
        "libmapperutils",
        "libvndksupport",
        "libsdmclient",
    ],

    static_libs: [
        "libaidlcommonsupport",
        "libbinder_random_parcel",
    ],
}

cc_binary {
    name: "vendor.qti.hardware.display.composer-service",
    defaults: [
        "qtidisplay_defaults",
        "composer-service_defaults",
        "composer3_defaults",
        "composer3_cflag_defaults",
        "composer3_displayconfig_aidlintf_lib_defaults",
    ],

    sanitize: {
        integer_overflow: true,
    },

    vendor: true,
    relative_install_path: "hw",

    cflags: [
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
        "-Wdeprecated-declarations",
        "-DLOG_TAG=\"SDM\"",
    ],

    srcs: composer_srcs,

    required: [
        "vendor.qti.hardware.display.composer-service.rc",
        "vendor.qti.hardware.display.composer-service.xml",
    ],

}

prebuilt_etc {
    name: "vendor.qti.hardware.display.composer-service.rc",
    src: "vendor.qti.hardware.display.composer-service.rc",
    filename_from_src: true,
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc_xml {
    name: "vendor.qti.hardware.display.composer-service.xml",
    src: select(soong_config_variable("qtidisplay", "composer_version"), {
        "v3_4": "vendor.qti.hardware.display.composer-service3_v4.xml",
        "v3_3": "vendor.qti.hardware.display.composer-service3_v3.xml",
        default: "vendor.qti.hardware.display.composer-service3_v2.xml",
    }),
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    vendor: true,
}

cc_fuzz {
    name: "displayconfig.aidl_fuzzer",
    defaults: [
        "qtidisplay_defaults",
        "composer-service_defaults",
        "composer3_defaults",
        "composer3_cflag_defaults",
        "composer3_displayconfig_aidlintf_lib_defaults",
    ],

    vendor: true,

    static_libs: [
        "libbinder_random_parcel",
    ],

    header_libs: [
        "libcutils_headers",
    ],

    shared_libs: [
        "libbinder_ndk",
        "libbinder",
        "libutils",
        "libjsoncpp",
        "libbase",
        "libcutils",
    ],

    srcs: [
        "AidlComposerClient.cpp",
        "AidlComposer.cpp",
        "AidlComposerHandleImporter.cpp",
        "DisplayConfigAIDL.cpp",
        "fuzzer.cpp",
        "gl_color_convert.cpp",
        "gl_color_convert_impl.cpp",
        "gl_common.cpp",
        "gl_layer_stitch.cpp",
        "gl_layer_stitch_impl.cpp",
        "hwc_buffer_allocator.cpp",
        "hwc_buffer_sync_handler.cpp",
        "hwc_common.cpp",
        "hwc_socket_handler.cpp",
        "QServiceBackend.cpp",
        "QtiComposer3Client.cpp",
    ],
}

soong_config_module_type {
    name: "qticomposer3_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "qtidisplay",
    variables: [
        "composer_version",
    ],
    properties: [
         "srcs",
         "cflags",
         "shared_libs",
         "vintf_fragments",
    ],
}

soong_config_string_variable {
    name: "composer_version",
    values: ["v3_2", "v3_3", "v3_4"],
}

qticomposer3_cc_defaults {
    name: "composer3_defaults",
    soong_config_variables: {
        composer_version: {
            v3_4: {
                srcs: ["DisplayAiqeAIDL.cpp"],
                shared_libs: [
                      "android.hardware.graphics.composer3-V4-ndk",
                      "vendor.qti.hardware.display.composer3-V4-ndk",
                      "vendor.qti.hardware.display.aiqe-V3-ndk",
                ],
            },
            v3_3: {
                srcs: ["DisplayAiqeAIDL.cpp"],
                shared_libs: [
                      "android.hardware.graphics.composer3-V3-ndk",
                      "vendor.qti.hardware.display.composer3-V3-ndk",
                      "vendor.qti.hardware.display.aiqe-V2-ndk",
                ],
            },
            v3_2: {
                shared_libs: [
                     "android.hardware.graphics.composer3-V2-ndk",
                     "vendor.qti.hardware.display.composer3-V2-ndk",
                ],
            },
        },
    },
}

qticomposer3_cc_defaults {
    name: "composer3_cflag_defaults",
    soong_config_variables: {
        composer_version: {
            v3_4: {
                cflags: [
                      "-DCOMPOSER3_V4",
                      "-DCOMPOSER3_V3",
                ],
            },
            v3_3: {
                cflags: ["-DCOMPOSER3_V3"],
            },
            conditions_default: {
                cflags: ["-DCOMPOSER3_V2"],
            },
        },
    },
}

qticomposer3_cc_defaults {
    name: "composer3_displayconfig_aidlintf_lib_defaults",
    soong_config_variables: {
        composer_version: {
            v3_4: {
                shared_libs: [
                      "vendor.qti.hardware.display.config-V13-ndk",
                ],
            },
            v3_3: {
                shared_libs: [
                      "vendor.qti.hardware.display.config-V12-ndk",
                ],
            },
            conditions_default: {
                shared_libs: [
                     "vendor.qti.hardware.display.config-V11-ndk",
                ],
            },
        },
    },
}

