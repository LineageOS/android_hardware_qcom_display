soong_namespace {
    imports: [
        "hardware/qcom-caf/sm8750/display",
    ],
}

composer_srcs = ["*.cpp"]


soong_config_module_type {
    name: "qticomposer3_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "qtidisplay",
    variables: [
        "composer_version",
    ],
    properties: [
         "cflags",
         "shared_libs",
         "vintf_fragments",
    ],
}

soong_config_string_variable {
    name: "composer_version",
    values: ["v2", "v3", "v3_3", "qmaa"],
}

qticomposer3_cc_defaults {
    name: "composer3_defaults",
    soong_config_variables: {
        composer_version: {
            v3_3: {
                cflags: ["-DCOMPOSER3_V3"],
                shared_libs: [
                      "android.hardware.graphics.composer3-V3-ndk",
                ],
                vintf_fragments: ["vendor.qti.hardware.display.composer-service3_v3.xml"],
            },
            conditions_default: {
                cflags: ["-DCOMPOSER3_V2"],
                shared_libs: [
                     "android.hardware.graphics.composer3-V2-ndk",
                ],
                vintf_fragments: ["vendor.qti.hardware.display.composer-service3_v2.xml"],
            },
        },
    },
}

cc_binary {

    name: "vendor.qti.hardware.display.composer-service",
    defaults: [
        "qti_qmaa_display_defaults",
        "composer3_defaults",
    ],
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,
    relative_install_path: "hw",
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],

    cflags: [
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
        "-DLOG_TAG=\"SDM\"",
    ],

    shared_libs: [
        "libbinder",
        "libhardware",
        "libutils",
        "libcutils",
        "libsync",
        "liblog",
        "libhidlbase",
        "libfmq",
        "libhardware_legacy",
        "libbinder_ndk",
        "libui",
    ],

    static_libs: [
        "libaidlcommonsupport",
    ],
    srcs: composer_srcs,

    init_rc: ["vendor.qti.hardware.display.composer-service.rc"],
}

