//libgrallocutils
cc_library_shared {
    name: "libgrallocutils",
    defaults: ["display_defaults"],
    vendor: true,

    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],
    shared_libs: [
        "libqdMetaData",
        "libdl",
        "android.hardware.graphics.common@1.1",
    ],
    cflags: [
        "-DLOG_TAG=\"qdgralloc\"",
        "-Wno-sign-conversion",
        "-Wno-enum-enum-conversion",
    ],
    srcs: [
        "gr_utils.cpp",
        "gr_adreno_info.cpp",
    ],
}

soong_config_module_type {
    name: "target_board_platform_cc_library_shared",
    module_type: "cc_library_shared",
    config_namespace: "ANDROID",
    value_variables: ["target_board_platform"],
    properties: [
        "name",
    ],
}

//gralloc.qcom
target_board_platform_cc_library_shared {
    name: "gralloc.qcom",
    soong_config_variables: {
        target_board_platform: {
            name: "gralloc.%s",
            conditions_default: {
                name: "gralloc.qcom",
            },
        },
    },
    defaults: ["display_defaults"],
    vendor: true,
    relative_install_path: "hw",
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],
    include_dirs: [
        "system/memory/libion/include",
        "system/memory/libion/kernel-headers",
    ],
    shared_libs: [
        "libgrallocutils",
        "libqdMetaData",
        "libsync",
        "android.hardware.graphics.common@1.1",
    ],
    cflags: [
        "-DLOG_TAG=\"qdgralloc\"",
        "-Wno-enum-enum-conversion",
    ],
    srcs: [
        "gr_ion_alloc.cpp",
        "gr_allocator.cpp",
        "gr_buf_mgr.cpp",
        "gr_device_impl.cpp",
    ],
}
